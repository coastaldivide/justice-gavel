{
  "appId": "app.justicegavel.desktop",
  "productName": "Justice Gavel",
  "copyright": "Copyright 2026 Justice Gavel, Inc.",
  "directories": {
    "output": "electron-dist",
    "buildResources": "assets"
  },
  "files": [
    "web-build/**/*",
    "electron/**/*",
    "assets/icon.png",
    "package.json",
    "!node_modules/**/*",
    "node_modules/{electron-log,electron-updater,builder-util-runtime,debug,ms,sax,fs-extra,graceful-fs,jsonfile,universalify,lazy-val,lodash.escaperegexp,lodash.isequal,tiny-typed-emitter,js-yaml,argparse,semver}/**/*"
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "icon": "assets/icon.png",
    "hardenedRuntime": true,
    "entitlements": "electron/entitlements.mac.plist",
    "entitlementsInherit": "electron/entitlements.mac.plist",
    "gatekeeperAssess": false,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ]
  },
  "win": {
    "icon": "assets/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "linux": {
    "icon": "assets/icon.png",
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility"
  },
  "publish": {
    "provider": "github",
    "owner": "coastaldivide",
    "repo": "justice-gavel"
  },
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "npmRebuild": false
}
