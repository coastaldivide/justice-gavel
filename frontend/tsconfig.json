{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "react",
      "react-native",
      "jest"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ]
  },
  "exclude": [
    "e2e/**/*",
    "e2e",
    "metro.config.js",
    "babel.config.js",
    "babel.test.config.js",
    "**/__tests__/**"
  ]
}
