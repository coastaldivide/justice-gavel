# Justice Gavel Frontend — Environment Variables
# Copy to .env and fill in your values

# Required — Your backend API
EXPO_PUBLIC_API_BASE=https://api.justicegavel.app/api

# Optional — Stripe publishable key (dashboard.stripe.com). Leave EMPTY until
# Stripe is set up: the app then runs with payments disabled and every
# Upgrade/Pay action shows "Payments are coming soon".
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — Analytics
EXPO_PUBLIC_MIXPANEL_TOKEN=...

# Optional — Error monitoring  
EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
