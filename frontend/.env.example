# Justice Gavel Frontend — build-time environment variables
# Copy to frontend/.env (or set as EAS secrets). EXPO_PUBLIC_* values are baked
# into the bundle at build time — never put a secret here.
# The same variables are listed in the repo-root and backend .env.example files.

# Backend API base. Unset → https://api.justicegavel.app/api (production).
# Local backend: http://localhost:4000/api
EXPO_PUBLIC_API_BASE=https://api.justicegavel.app/api

# Stripe publishable key (dashboard.stripe.com). Leave EMPTY until Stripe is set
# up: the app then runs with payments disabled and every Upgrade/Pay action
# shows "Payments aren't available yet".
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Analytics (optional)
EXPO_PUBLIC_MIXPANEL_TOKEN=

# Error monitoring (optional), e.g. https://<key>@<org>.ingest.sentry.io/<project>
EXPO_PUBLIC_SENTRY_DSN=

# "true" on beta/TestFlight builds shows the beta banner
EXPO_PUBLIC_BETA=
