    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-store-review": "~8.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-updates": "~0.27.5",
    "mixpanel-react-native": "3.3.0",
    "react": "18.3.1",
