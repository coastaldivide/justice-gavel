{
  "name": "justicegavel",
  "version": "8.7.60",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --config jest.frontend.config.js --no-coverage && jest --config jest.render.config.js",
    "test:coverage": "jest --config jest.frontend.config.js --coverage",
    "start:web": "expo start --web",
    "build:web": "expo export --platform web",
    "serve:web": "npx serve dist",
    "electron:dev": "ELECTRON_START_URL=http://localhost:8081 electron electron/main.js",
    "electron:build": "expo export --platform web --output-dir web-build && electron-builder --config electron-builder.json",
    "electron:pack": "electron-builder --config electron-builder.json --dir",
    "electron:dmg": "expo export --platform web --output-dir web-build && electron-builder --config electron-builder.json --mac dmg",
    "typecheck": "tsc --noEmit",
    "typecheck:report": "bash ../scripts/tsc-error-report.sh --save",
    "typecheck:ci": "bash ../scripts/typecheck.sh --summary",
    "build:check": "bash ../scripts/build-check.sh web",
    "ci": "bash ../scripts/check-all.sh",
    "test:render": "jest --config jest.render.config.js",
    "lint": "eslint src App.tsx --max-warnings 0",
    "check:nav": "node scripts/check-nav-targets.mjs",
    "test:logic": "jest --config jest.frontend.config.js --no-coverage",
    "smoke:web": "node scripts/web-smoke.cjs dist web-smoke-out",
    "smoke:electron": "node scripts/electron-smoke.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
