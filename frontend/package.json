    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.10.1",
    "@sentry/react-native": "~6.10.0",
    "@shopify/flash-list": "1.7.3",
    "@stripe/stripe-react-native": "0.38.6",
    "axios": "^1.16.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "expo": "~52.0.49",
    "expo-av": "~15.0.2",
    "expo-calendar": "~14.0.6",
