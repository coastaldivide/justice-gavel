# ── Justice Gavel — Environment Variables (repo-root copy) ───────────────────
# Identical to backend/.env.example (a jest test keeps them in sync). The
# backend reads backend/.env; the app reads frontend/.env (EXPO_PUBLIC_* only).
# Copy the relevant section, fill in what you need. NEVER commit .env.
# Full reference (what each var does, defaults, deploy steps): ./DEPLOY_ENV_SETUP.md
# Generate secrets with:  openssl rand -hex 32
#
# Everything is optional in development: missing secrets are generated per
# process, and each missing feature key just disables that feature (a
# "feature disabled" line is logged at boot).

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REQUIRED IN PRODUCTION (the server refuses to start without these)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

NODE_ENV=development
# Which deployment this is: development | test | staging | production.
# Staging = NODE_ENV=production + APP_ENV=staging (own DB, test Stripe keys).
#APP_ENV=
# Staging only: the PRODUCTION database URL, so staging refuses to boot against it
#PRODUCTION_DATABASE_URL=
# PostgreSQL connection string (POSTGRES_URL accepted as an alias).
# Apply supabase/migrations/*.sql in filename order before first boot.
DATABASE_URL=postgres://localhost/justice_gavel
# Alias of DATABASE_URL (only read when DATABASE_URL is unset)
#POSTGRES_URL=
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=GENERATE_WITH_openssl_rand_hex_32_DIFFERENT_FROM_JWT_SECRET
# AES-256-GCM key for messages/case notes at rest — never change once data exists
ENCRYPTION_KEY=GENERATE_WITH_openssl_rand_hex_32

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FEATURE KEYS — each enables one feature; absent = that feature is disabled
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# AI (console.anthropic.com) — without it AI endpoints return 503 ai_unavailable
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Tests/mock server only — never set in production
#ANTHROPIC_BASE_URL=

# Global daily AI spend cap (USD, UTC day). When today's metered spend reaches
# it, AI features answer 503 ai_unavailable until midnight UTC; SEV-2 alert at
# AI_BUDGET_ALERT_PCT, SEV-1 at 100 %. 'off' disables the cap (not recommended).
AI_DAILY_BUDGET_USD=50
AI_BUDGET_ALERT_PCT=80
# Optional: override the per-million-token prices used to meter spend
#AI_PRICE_INPUT_PER_MTOK=
#AI_PRICE_OUTPUT_PER_MTOK=

# Payments — without a key every billing endpoint returns 503 payments_unavailable
# and the app shows "Payments are not available yet". Setting it re-enables Stripe.
STRIPE_SECRET_KEY=
# Legacy alias of STRIPE_SECRET_KEY — prefer STRIPE_SECRET_KEY
#STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://justicegavel.app/payment/success
STRIPE_CANCEL_URL=https://justicegavel.app/payment/cancel
STRIPE_ACH_ENABLED=false
# Subscription price ids (create the products in the Stripe dashboard)
STRIPE_LEGAL_RADAR_ID=
STRIPE_ADVISOR_PRICE_ID=
STRIPE_ADVISOR_ANNUAL_ID=
STRIPE_LEGAL_PRO_PRICE_ID=
STRIPE_LEGAL_PRO_ANNUAL_ID=
STRIPE_ESQUIRE_PRICE_ID=
STRIPE_ESQUIRE_ANNUAL_ID=
STRIPE_BONDSMAN_STARTER_ID=
STRIPE_BONDSMAN_STARTER_ANNUAL_ID=
STRIPE_BONDSMAN_PRO_ID=
STRIPE_BONDSMAN_PRO_ANNUAL_ID=
STRIPE_BONDSMAN_MARKET_ID=
STRIPE_BONDSMAN_MARKET_ANNUAL_ID=

# Email via Resend (resend.com) — without it emails are logged, never sent
RESEND_API_KEY=
# "false" forces log-only even when RESEND_API_KEY is set
LIVE_EMAIL=
EMAIL_FROM=noreply@justicegavel.app
ALERT_EMAIL_FROM=alerts@justicegavel.app

# Queue — without it AI jobs run in-process
REDIS_URL=

# Error tracking (sentry.io)
SENTRY_DSN=
#SENTRY_ENVIRONMENT=
#SENTRY_RELEASE=
#SENTRY_TRACES_SAMPLE_RATE=0.1
#SENTRY_PROFILES_SAMPLE_RATE=0.1
#SENTRY_PROFILING=true

# Whisper transcription (OpenAI)
OPENAI_API_KEY=
# Daily.co video consultation rooms
DAILY_API_KEY=
#DAILY_API_BASE=https://api.daily.co/v1
#METRICS_TOKEN=
# Data refresh (scrapers write the main Postgres DB; changes to existing providers are staged for review)
GOOGLE_PLACES_KEY=
YELP_API_KEY=
# Places rate limit (ms between requests, default 150) and request budget per run (default 5000)
#GOOGLE_PLACES_MIN_INTERVAL_MS=150
#GOOGLE_PLACES_MAX_REQUESTS=5000
# Supabase Storage (attachments)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Push notifications
EXPO_ACCESS_TOKEN=
# Expo push endpoint override (default https://exp.host/--/api/v2)
EXPO_PUSH_API_URL=
# Text messages (court reminders, SOS texts) through Telnyx — API key + a 10DLC-registered
# sender. Unset → no texts; push → browser push → e-mail still go out.
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# Optional: Telnyx messaging profile id; API base override (default https://api.telnyx.com/v2)
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_API_BASE=
# Telnyx webhook public key (base64) — verifies POST /api/webhooks/telnyx (STOP replies)
TELNYX_PUBLIC_KEY=
# Express trust proxy: hop count (default 1) or a CIDR list such as 100.0.0.0/8 — see RUNBOOK "Client IP"
TRUST_PROXY=
# Web push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@justicegavel.app

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# URLS, CORS, AUTH TUNING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

PORT=4000
# Extra comma-separated browser origins (prod domains + localhost are built in)
CORS_ORIGIN=
EXTRA_ORIGINS=
FRONTEND_URL=
# Base URL used in password-reset links
APP_URL=https://justicegavel.app
# This API's public URL (SAML ACS + OAuth redirect URIs)
BASE_URL=https://api.justicegavel.app
APP_SSO_REDIRECT=
APP_OAUTH_REDIRECT=
# X-Admin-Key header for /api/admin and /api/bot (timing-safe compare)
ADMIN_KEY=GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=60d
AUTH_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
RATE_LIMIT_PER_MIN=200
# Lawyer / bail-agent directory cache in ms (0 = off). Default 60000.
DIRECTORY_CACHE_TTL_MS=60000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ATTACHMENTS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# off | local | supabase (auto-picks when unset). "off" → upload returns 503.
ATTACHMENTS_STORAGE=
ATTACHMENTS_DIR=
ATTACHMENTS_BUCKET=case-documents

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SCHEDULER, ALERTS, ADMIN
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Nightly scheduler (scrapers, alerts, payment-link expiry, token cleanup)
LIVE_REFRESH=false
# Reminder delivery (court dates etc.) runs regardless of LIVE_REFRESH; false turns it off
REMINDERS_ENABLED=true
REFRESH_CRON=0 3 * * *
REFRESH_TZ=America/Chicago
HEALTH_SCAN_CRON=0 2 * * *
SCAN_QUIET=false
ALERT_EMAIL=
ONCALL_EMAIL=
ONCALL_EMAIL_2=
ALERT_WEBHOOK_URL=
ADMIN_EMAIL=
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_SMS=
ADMIN_PANEL_URL=
ADMIN_URL=
# Only "true" counts in production; reported by /health as mode demo|live
DEMO_MODE=false
# /api/pay multi-provider orchestrator: returns a mock session URL unless "true"
# (and still 503 payments_unavailable without STRIPE_SECRET_KEY)
LIVE_PAYMENTS=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PERFORMANCE / OPS TUNING (defaults shown)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

HEALTH_CACHE_MS=5000
SLOW_QUERY_MS=500
PG_POOL_MAX=20
#PGSSL=false
MEMORY_LIMIT_MB=512
AI_CONCURRENCY=8
AI_JOB_TIMEOUT_MS=45000
AI_DRAIN_TIMEOUT_MS=10000
LOG_LEVEL=info
# json | text — production defaults to one-line JSON
LOG_FORMAT=
#DB_LOG_ERRORS=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ARREST DATA (see DEPLOY_ENV_SETUP.md for the exact feed shape)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# JSON array of public arrest feeds, e.g.
# [{"id":"davidson_tn","url":"https://example.gov/bookings.json","state":"TN","county":"Davidson"}]
# UNSET (default) = no arrest coverage; the app shows honest empty states.
ARREST_FEED_URLS=
# Demos only — seeded sample arrest rows stay hidden unless this is "true"
SHOW_SAMPLE_ARRESTS=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# INTEGRATION OAUTH CREDENTIALS (optional — demo data without them)
# Redirect URI to register:  <BASE_URL>/api/integrations/oauth/callback
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
MYCASE_CLIENT_ID=
MYCASE_CLIENT_SECRET=
PRACTICEPANTHER_CLIENT_ID=
PRACTICEPANTHER_CLIENT_SECRET=
IMANAGE_CLIENT_ID=
IMANAGE_CLIENT_SECRET=
NETDOCUMENTS_CLIENT_ID=
NETDOCUMENTS_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
COURTLISTENER_ENABLED=true
COURTLISTENER_TOKEN=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ALTERNATIVE PAYMENT PROVIDERS (all optional; inert without keys)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
BRAINTREE_MERCHANT_ID=
SQUARE_ACCESS_TOKEN=
AUTHORIZE_NET_API_LOGIN_ID=
AMAZON_PAY_PUBLIC_KEY_ID=
COINBASE_COMMERCE_API_KEY=
BITPAY_TOKEN=
NOWPAYMENTS_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPERATOR / SCRAPER-ONLY
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# fact_check_monitor.js report output dir (default ./reports)
REPORT_DIR=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SET BY THE PLATFORM (Render) — do not set by hand
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

#RENDER=true
#RENDER_GIT_COMMIT=
#RENDER_INSTANCE_ID=
# Host-neutral fallback for the deployed commit (other hosts / local docker)
#GIT_COMMIT=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FRONTEND BUILD-TIME VARIABLES (frontend/.env or EAS secrets — NOT read by
# the backend). EXPO_PUBLIC_* values are baked into the app bundle.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# API base the app talks to. Unset → https://api.justicegavel.app/api
EXPO_PUBLIC_API_BASE=http://localhost:4000/api
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MIXPANEL_TOKEN=
# Stripe publishable key for the native payment sheet (payments stay disabled
# until the backend has STRIPE_SECRET_KEY too)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# "true" on beta/TestFlight builds shows the beta banner
EXPO_PUBLIC_BETA=
