# Justice Gavel — Root .env.example
# Copy to .env and fill in values

# ── Backend (backend/.env) ─────────────────────────────────────────────────────
# Required: set in Railway Environment Variables
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_32_BYTES_HEX
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX
ADMIN_KEY=CHANGE_ME_RANDOM_24_CHARS
STRIPE_SECRET=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME
TWILIO_ACCOUNT_SID=ACCHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1CHANGE_ME
SENDGRID_API_KEY=SG.CHANGE_ME
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
CORS_ORIGIN=https://app.justicegavel.com
NODE_ENV=development
PORT=4000

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# POSTGRES_URL=postgresql://user:pass@host:5432/dbname
# LOG_LEVEL=info
# LOG_FORMAT=json
# EXPO_ACCESS_TOKEN=your-expo-token

# ── Frontend (frontend/.env) ───────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE=http://localhost:4000/api
EXPO_PUBLIC_SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
EXPO_PUBLIC_MIXPANEL_TOKEN=CHANGE_ME


# ── Critical production env vars ──────────────────────────

SUPABASE_URL=https://your-project.supabase.co   # Supabase project URL

SUPABASE_SERVICE_KEY=eyJhbGciO...   # Supabase service role key (secret)

STRIPE_SECRET_KEY=sk_live_...   # Stripe secret key (use sk_test_ for dev)

JWT_REFRESH_SECRET=your-other-32-char-secret   # JWT refresh token secret

REDIS_URL=redis://localhost:6379   # Redis connection URL

RESEND_API_KEY=re_...   # Resend email API key

DAILY_API_KEY=your-daily-key   # Daily.co video API key

STRIPE_BONDSMAN_STARTER_ID=price_xxxx   # Stripe price ID: Bondsman Starter $49/mo

STRIPE_BONDSMAN_PRO_ID=price_xxxx   # Stripe price ID: Bondsman Pro $149/mo

STRIPE_BONDSMAN_MARKET_ID=price_xxxx   # Stripe price ID: Bondsman Market $349/mo

STRIPE_LEGAL_RADAR_ID=price_xxxx   # Stripe price ID: Consumer Legal Radar $19.99/mo

STRIPE_ADVISOR_PRICE_ID=price_xxxx   # Stripe price ID: Consumer Advisor $24.99/mo

STRIPE_LEGAL_PRO_PRICE_ID=price_xxxx   # Stripe price ID: Consumer Legal Pro $34.99/mo

STRIPE_ESQUIRE_PRICE_ID=price_xxxx   # Stripe price ID: Consumer Esquire $49/mo

VAPID_PUBLIC_KEY=your-vapid-public   # VAPID key for web push (npm run generate-vapid)

VAPID_PRIVATE_KEY=your-vapid-private   # VAPID private key

APP_URL=https://your-domain.com   # Production app URL

BASE_URL=https://api.your-domain.com   # Production API base URL