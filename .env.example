# Justice Gavel — Root .env.example
# Copy to .env and fill in values

# ── Backend (backend/.env) ─────────────────────────────────────────────────────
# Required: set in Railway Environment Variables
# Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_32_BYTES_HEX
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX
ADMIN_KEY=CHANGE_ME_RANDOM_24_CHARS
STRIPE_SECRET=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=sk-CHANGE_ME
TWILIO_ACCOUNT_SID=ACCHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1CHANGE_ME
SENDGRID_API_KEY=SG.CHANGE_ME
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
CORS_ORIGIN=https://app.justicegavel.com
NODE_ENV=development
PORT=4000

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# POSTGRES_URL=postgresql://user:pass@host:5432/dbname
# LOG_LEVEL=info
# LOG_FORMAT=json
# EXPO_ACCESS_TOKEN=your-expo-token

# ── Frontend (frontend/.env) ───────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE=http://localhost:4000/api
EXPO_PUBLIC_SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
EXPO_PUBLIC_MIXPANEL_TOKEN=CHANGE_ME


# ── Critical production env vars ──────────────────────────

SUPABASE_URL=https://your-project.supabase.co   # Supabase project URL

SUPABASE_SERVICE_KEY=eyJhbGciO...   # Supabase service role key (secret)

STRIPE_SECRET_KEY=sk_live_...   # Stripe secret key (use sk_test_ for dev)

JWT_REFRESH_SECRET=your-other-32-char-secret   # JWT refresh token secret

REDIS_URL=redis://localhost:6379   # Redis connection URL

RESEND_API_KEY=re_...   # Resend email API key

DAILY_API_KEY=your-daily-key   # Daily.co video API key

STRIPE_BONDSMAN_STARTER_ID=price_xxxx   # Stripe price ID: Bondsman Starter $49/mo

STRIPE_BONDSMAN_PRO_ID=price_xxxx   # Stripe price ID: Bondsman Pro $149/mo

STRIPE_BONDSMAN_MARKET_ID=price_xxxx   # Stripe price ID: Bondsman Market $349/mo

STRIPE_LEGAL_RADAR_ID=price_xxxx   # Stripe price ID: Consumer Legal Radar $19.99/mo

STRIPE_ADVISOR_PRICE_ID=price_xxxx   # Stripe price ID: Consumer Advisor $24.99/mo

STRIPE_LEGAL_PRO_PRICE_ID=price_xxxx   # Stripe price ID: Consumer Legal Pro $34.99/mo

STRIPE_ESQUIRE_PRICE_ID=price_xxxx   # Stripe price ID: Consumer Esquire $49/mo

VAPID_PUBLIC_KEY=your-vapid-public   # VAPID key for web push (npm run generate-vapid)

VAPID_PRIVATE_KEY=your-vapid-private   # VAPID private key

APP_URL=https://your-domain.com   # Production app URL

BASE_URL=https://api.your-domain.com   # Production API base URL

# ── Admin & Alerts ────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com  # Admin notification email
ADMIN_ALERT_EMAIL=alerts@yourdomain.com # Alert recipient
ADMIN_ALERT_SMS=+15551234567          # Admin SMS for critical alerts
ADMIN_PANEL_URL=https://admin.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
ALERT_EMAIL=alerts@yourdomain.com
ALERT_EMAIL_FROM=noreply@yourdomain.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/... # Slack webhook for alerts
ONCALL_EMAIL=oncall@yourdomain.com
ONCALL_EMAIL_2=oncall2@yourdomain.com

# ── URLs & Origins ────────────────────────────────────
FRONTEND_URL=https://justicegavel.app
APP_OAUTH_REDIRECT=https://justicegavel.app/auth/callback
APP_SSO_REDIRECT=https://justicegavel.app/sso/callback
EXTRA_ORIGINS=https://admin.justicegavel.app
BOT_WEBHOOK_BASE_URL=https://api.justicegavel.app

# ── AI & Concurrency ──────────────────────────────────
AI_CONCURRENCY=5  # Max parallel AI requests
SCAN_QUIET=false  # Suppress scan output in CI
COURTLISTENER_ENABLED=false  # Enable CourtListener API
COURTLISTENER_TOKEN=your-courtlistener-token
JUDYRECORDS_API_KEY=your-judyrecords-key
YELP_API_KEY=your-yelp-api-key  # For attorney firm lookup

# ── Auth & Security ───────────────────────────────────
SECRET=your-32-char-session-secret
SELF_HEAL_SECRET=your-self-heal-webhook-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-secret

# ── Storage & Uploads ─────────────────────────────────
UPLOAD_DIR=/tmp/uploads  # Local upload directory
REPORT_DIR=/tmp/reports
PROVIDERS_DB=/tmp/providers.db  # Legacy SQLite (deprecated)

# ── Third-Party Integrations ──────────────────────────
CLIO_CLIENT_ID=your-clio-client-id
CLIO_CLIENT_SECRET=your-clio-secret
MYCASE_CLIENT_ID=your-mycase-client-id
MYCASE_CLIENT_SECRET=your-mycase-secret
PRACTICEPANTHER_CLIENT_ID=your-pp-client-id
PRACTICEPANTHER_CLIENT_SECRET=your-pp-secret
NETDOCUMENTS_CLIENT_ID=your-netdoc-client-id
NETDOCUMENTS_CLIENT_SECRET=your-netdoc-secret
IMANAGE_CLIENT_ID=your-imanage-client-id
IMANAGE_CLIENT_SECRET=your-imanage-secret
GOOGLE_CALENDAR_CLIENT_ID=your-gcal-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-gcal-secret
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-secret
GOOGLE_PLACES_KEY=your-places-api-key

# ── Alternative Payment Processors (optional) ─────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
SQUARE_ACCESS_TOKEN=your-square-token
AMAZON_PAY_PUBLIC_KEY_ID=your-amazon-pay-key
BRAINTREE_MERCHANT_ID=your-braintree-id
COINBASE_COMMERCE_API_KEY=your-coinbase-key
NOWPAYMENTS_KEY=your-nowpayments-key
AUTHORIZE_NET_API_LOGIN_ID=your-authnet-id
BITPAY_TOKEN=your-bitpay-token
STRIPE_ACH_ENABLED=false  # Enable ACH bank payments
STRIPE_CANCEL_URL=https://justicegavel.app/cancel
STRIPE_SUCCESS_URL=https://justicegavel.app/success

# ── Logging & Monitoring ──────────────────────────────
LOG_LEVEL=info  # debug | info | warn | error
LOG_FORMAT=json  # json | pretty
SENTRY_AUTH_TOKEN=your-sentry-auth-token
RAILWAY_ENVIRONMENT=production
HEALTH_SCAN_CRON=0 7 * * 0  # Weekly Sunday 7am
REFRESH_CRON=0 3 * * *  # Daily 3am refresh
REFRESH_TZ=America/Chicago
