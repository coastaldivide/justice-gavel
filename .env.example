# Justice Gavel — root .env.example
#
# Backend configuration lives in backend/.env (copy backend/.env.example).
# Every backend variable is documented in RAILWAY_ENV_SETUP.md.
#
# This file only covers the FRONTEND build-time variables (frontend/.env or
# EAS secrets — EXPO_PUBLIC_* values are baked into the bundle at build time).

# API base the app talks to. Unset, the app falls back to the production API
# (https://api.justicegavel.app/api). For local dev:
EXPO_PUBLIC_API_BASE=http://localhost:4000/api

# Error tracking + analytics (both optional; features are off without them)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MIXPANEL_TOKEN=

# Stripe publishable key for the native payment sheet (payments stay disabled
# until the backend has STRIPE_SECRET_KEY as well)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Set to "true" on beta/TestFlight builds to show the beta banner
EXPO_PUBLIC_BETA=
